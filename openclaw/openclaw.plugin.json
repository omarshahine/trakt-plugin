{
  "id": "trakt-tools",
  "name": "Trakt",
  "description": "Track movies and TV shows using trakt.tv",
  "version": "1.11.1",
  "configSchema": {
    "type": "object",
    "properties": {
      "cliPath": {
        "type": "string",
        "description": "Path to trakt-cli binary",
        "default": "trakt-cli"
      },
      "clientId": {
        "type": "string",
        "description": "Trakt API client ID (from https://trakt.tv/oauth/applications)"
      },
      "clientSecret": {
        "type": "string",
        "description": "Trakt API client secret"
      },
      "syncEnabled": {
        "type": "boolean",
        "description": "Opt in to the trakt_sync tool (imports from streaming services). Off by default.",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "uiHints": {
    "cliPath": {
      "label": "CLI Path",
      "help": "Path or command name for the trakt-cli binary. Defaults to finding it on PATH.",
      "placeholder": "trakt-cli"
    },
    "clientId": {
      "label": "Client ID",
      "help": "Trakt API client ID from https://trakt.tv/oauth/applications",
      "sensitive": true
    },
    "clientSecret": {
      "label": "Client Secret",
      "help": "Trakt API client secret from https://trakt.tv/oauth/applications",
      "sensitive": true
    },
    "syncEnabled": {
      "label": "Enable streaming sync",
      "help": "Registers trakt_sync. Also requires ~/.config/trakt-cli/sync.yaml with enabled: true; see `trakt-cli sync --help`."
    }
  },
  "contracts": {
    "tools": [
      "trakt_search",
      "trakt_title_details",
      "trakt_show_seasons",
      "trakt_season_episodes",
      "trakt_episode_details",
      "trakt_discover_trending",
      "trakt_discover_popular",
      "trakt_discover_recommendations",
      "trakt_discover_related",
      "trakt_history",
      "trakt_history_add",
      "trakt_history_remove",
	  "trakt_history_remove_event",
	  "trakt_backup_restore_ratings",
	  "trakt_backup_restore_favorites",
      "trakt_backup_restore_collections",
      "trakt_backup_plan_collection",
      "trakt_backup",
        "trakt_backup_compare",
        "trakt_backup_plan_restore",
      "trakt_lists",
        "trakt_list_items",
        "trakt_list_create",
      "trakt_list_update",
        "trakt_list_add",
        "trakt_list_remove",
        "trakt_list_notes",
        "trakt_list_reorder",
        "trakt_ratings",
        "trakt_rating_set",
        "trakt_rating_remove",
        "trakt_favorites",
        "trakt_favorite_add",
        "trakt_favorite_remove",
      "trakt_watchlist",
      "trakt_watchlist_add",
      "trakt_watchlist_remove",
      "trakt_calendar",
      "trakt_progress",
      "trakt_auth",
      "trakt_sync"
    ]
  }
}
